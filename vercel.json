-- Create candidates table
CREATE TABLE candidates (
  id TEXT PRIMARY KEY,
  firstName TEXT NOT NULL,
  lastName TEXT NOT NULL,
  title TEXT,
  location TEXT,
  email TEXT,
  phone TEXT,
  source TEXT,
  seniority TEXT,
  availability TEXT,
  linkedin TEXT,
  other TEXT,
  role1 TEXT,
  role2 TEXT,
  skills TEXT,
  education TEXT,
  languages TEXT,
  notes TEXT,
  stage TEXT DEFAULT 'sourced',
  score INT,
  profileSent BOOLEAN DEFAULT false,
  added TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Create roles table
CREATE TABLE roles (
  id TEXT PRIMARY KEY,
  title TEXT NOT NULL,
  client TEXT,
  status TEXT DEFAULT 'Sourcing',
  priority TEXT DEFAULT 'None',
  opened TEXT,
  deadline TEXT,
  salary TEXT,
  location TEXT,
  url TEXT,
  email TEXT,
  musthave TEXT,
  notes TEXT,
  description TEXT,
  activeCandidates INT DEFAULT 0,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Create jobs table
CREATE TABLE jobs (
  id TEXT PRIMARY KEY,
  title TEXT NOT NULL,
  location TEXT,
  type TEXT,
  client TEXT,
  salary TEXT,
  description TEXT,
  requirements TEXT,
  active BOOLEAN DEFAULT true,
  added TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Create profiles table
CREATE TABLE profiles (
  id TEXT PRIMARY KEY,
  candidate_id TEXT NOT NULL REFERENCES candidates(id) ON DELETE CASCADE,
  summary TEXT,
  highlights TEXT,
  skills JSONB,
  experience JSONB,
  education TEXT,
  languages TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Create indexes for faster queries
CREATE INDEX idx_candidates_stage ON candidates(stage);
CREATE INDEX idx_candidates_source ON candidates(source);
CREATE INDEX idx_roles_status ON roles(status);
CREATE INDEX idx_jobs_active ON jobs(active);
CREATE INDEX idx_profiles_candidate ON profiles(candidate_id);
